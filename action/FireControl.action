# FireControl.action
# 发射控制 Action - 供导航/行为树调用

# ===== Goal =====
uint8 FIRE_MODE_SINGLE = 0
uint8 FIRE_MODE_BURST = 1
uint8 FIRE_MODE_AUTO = 2

bool fire                    # 是否发射
uint8 fire_mode              # 发射模式: 0=单发, 1=连发, 2=自动
uint16 shot_count            # 发射数量（单发/连发模式用）
float64 duration_sec         # 持续时间（自动模式用）
float64 friction_speed       # 摩擦轮速度，0使用默认值

---

# ===== Result =====
bool success                 # 是否成功完成
uint16 shots_fired           # 已发射数量
float64 elapsed_time_sec     # 耗时
string message               # 结果消息

---

# ===== Feedback =====
uint16 shots_fired           # 已发射数量
uint16 shots_remaining       # 剩余数量（如果适用）
float64 heat_remaining       # 剩余热量（裁判系统）
bool reloading               # 是否正在装填
bool friction_ready          # 摩擦轮是否就绪
